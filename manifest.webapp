{
  "name": "Ferraris",
  "description": "App store for Firefox OS. Installs apps straight from GitHub repositories.",
  "version": "1.1.0",
  "launch_path": "/index.html",
  "icons": {
    "60": "/icons/icon-60.png",
    "128": "/icons/icon-128.png"
